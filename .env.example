# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave de sesión de Flask. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_un_valor_aleatorio

# Ruta de la base de datos SQLite
DATABASE_PATH=data/noc.db

# Receptor Syslog UDP (5514 evita requerir permisos de administrador)
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514

# Operador por defecto que aparece en la auditoría
DEFAULT_OPERATOR=operador_noc

# --- Fase 4: política de defensa ---
# Máximo de mensajes UDP por minuto desde una misma fuente (control de tormentas)
STORM_MAX_PER_MINUTE=100
# Horario laboral (hora local). Fuera de él, los cambios de configuración se marcan
BUSINESS_HOURS=07-19
LOCAL_UTC_OFFSET=-5
# Prefijos de cuentas de servicio (separados por coma)
SERVICE_ACCOUNT_PREFIXES=svc_
